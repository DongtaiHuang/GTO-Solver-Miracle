FROM node:24-bookworm-slim AS web
WORKDIR /app
COPY package.json package-lock.json ./
COPY frontend/package.json frontend/
RUN npm ci
COPY frontend frontend
ENV NEXT_PUBLIC_GUEST_DEMO=true NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM python:3.12-slim-bookworm
WORKDIR /app
COPY backend/pyproject.toml ./
COPY backend/src src
RUN python -m pip install --no-cache-dir 'pip>=26.2,<27' && pip install --no-cache-dir . && useradd --create-home app
COPY --from=web /usr/local/bin/node /usr/local/bin/node
COPY --from=web --chown=app:app /app /app
COPY tools/start_guest_demo.py /app/tools/start_guest_demo.py
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 NEXT_PUBLIC_GUEST_DEMO=true PORT=10000
USER app
EXPOSE 10000
CMD ["python","tools/start_guest_demo.py"]
